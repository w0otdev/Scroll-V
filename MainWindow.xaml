<Window x:Class="ScrollV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Scroll-V"
        Height="695" Width="440"
        WindowStyle="None"
        Background="#C8C2AE"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/appicon.ico">

    <Window.Resources>
        <Style x:Key="SectionHeadingBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionHeadingText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextInvertedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowContainer" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LangSegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextInvertedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextInvertedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Assets/appicon.ico"
                        ToolTipText="Scroll-V"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayOpenMenuItem" Header="Open HUD terminal" Click="TrayOpen_Click"/>
                    <MenuItem x:Name="TrayToggleMenuItem" Header="Toggle smooth scroll" Click="TrayToggle_Click"/>
                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                    <MenuItem x:Name="TrayExitMenuItem" Header="Terminate Scroll-V" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Main YoRHa Tactical Frame -->
        <Border x:Name="MainContainer"
                Background="{StaticResource YorhaGridBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="2"
                CornerRadius="0"
                ClipToBounds="True">

            <!-- Inner Architectural Frame -->
            <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Margin="3">
                <DockPanel>
                    <!-- YoRHa Bunker Header Banner -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="0,0,0,2"
                            Padding="14,10"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <!-- Tactical Diamond / Square Glyph -->
                                <Rectangle Width="8" Height="8"
                                           Fill="{StaticResource TextInvertedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="SCROLL-V"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInvertedBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Width="1" Height="12"
                                        Background="{StaticResource TextSecondaryBrush}"
                                        Margin="10,0"/>
                                <Rectangle x:Name="StatusIndicator"
                                           Width="7" Height="7"
                                           Fill="{StaticResource TextInvertedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText"
                                           Text="TRỰC TUYẾN"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInvertedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- YoRHa Language Selector -->
                                <Border Background="{StaticResource AccentHoverBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="1"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="LangViButton"
                                                Content="VI"
                                                Style="{StaticResource LangSegmentButton}"
                                                Click="LangViButton_Click"/>
                                        <Button x:Name="LangEnButton"
                                                Content="EN"
                                                Style="{StaticResource LangSegmentButton}"
                                                Click="LangEnButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="MinimizeButton"
                                        Style="{StaticResource ChromeMinimizeButton}"
                                        Margin="0,0,2,0"
                                        Click="MinimizeButton_Click"/>
                                <Button x:Name="CloseButton"
                                        Style="{StaticResource ChromeCloseButton}"
                                        Click="CloseButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Decorative Sub-Header Telemetry Strip -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,4">
                        <Grid>
                            <TextBlock Text="TACTICAL INPUT INTERPOLATION SYSTEM"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SysVersionText"
                                       Text="SYS.VER // 1.1"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- YoRHa Footer Telemetry Bar -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Rectangle Width="4" Height="4"
                                           Fill="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="LblMadeBy"
                                           Text="ĐƠN VỊ PHÁT TRIỂN: W00TDEV"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="[GITHUB]"
                                        Style="{StaticResource FooterLinkButton}"
                                        Click="SocialGithub_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Scrollable Content -->
                    <ScrollViewer x:Name="ContentScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ThinScrollViewer}">
                        <StackPanel Margin="14,12,14,14">

                            <!-- Section 01: System -->
                            <Border Style="{StaticResource SectionHeadingBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="5" Height="5"
                                                   Fill="{StaticResource TextInvertedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock x:Name="LblSettings"
                                                   Text="HỆ THỐNG CƠ BẢN"
                                                   Style="{StaticResource SectionHeadingText}"/>
                                    </StackPanel>
                                    <TextBlock Text="[01]"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BorderSubtleBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SurfaceSection}" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Master Enable Smooth Scroll -->
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="LblEnableSmooth"
                                                           Text="Cuộn mượt toàn hệ thống"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="LblEnableSmoothDesc"
                                                           Text="Làm mượt con lăn chuột trên mọi cửa sổ"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="EnableToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource PrecisionToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="EnableToggle_Changed"
                                                      Unchecked="EnableToggle_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Start with Windows -->
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="LblStartWindows"
                                                           Text="Khởi động cùng hệ điều hành"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="LblStartWindowsDesc"
                                                           Text="Chạy ngầm trong khay hệ thống khi bật máy"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StartupToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource PrecisionToggle}"
                                                      VerticalAlignment="Center"
                                                      Checked="StartupToggle_Changed"
                                                      Unchecked="StartupToggle_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Scroll Acceleration -->
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="LblAcceleration"
                                                           Text="Gia tốc theo lực lăn"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="LblAccelerationDesc"
                                                           Text="Tăng quãng đường khi lăn chuột liên tục"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AccelerationToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource PrecisionToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="AccelerationToggle_Changed"
                                                      Unchecked="AccelerationToggle_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section 02: Scroll Physics -->
                            <Border Style="{StaticResource SectionHeadingBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="5" Height="5"
                                                   Fill="{StaticResource TextInvertedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock x:Name="LblTuning"
                                                   Text="THÔNG SỐ VẬT LÝ"
                                                   Style="{StaticResource SectionHeadingText}"/>
                                    </StackPanel>
                                    <TextBlock Text="[02]"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BorderSubtleBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SurfaceSection}" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Smoothness -->
                                    <Border Padding="14,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="LblSmoothness"
                                                           Text="Độ mượt phản hồi"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SmoothnessValue"
                                                           Text="Rất mượt"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SmoothnessSlider"
                                                    Minimum="5" Maximum="30" Value="5"
                                                    Style="{StaticResource ModernSlider}"
                                                    ValueChanged="SmoothnessSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Speed -->
                                    <Border Padding="14,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="LblSpeed"
                                                           Text="Tốc độ bước cuộn"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SpeedValue"
                                                           Text="1.4x"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SpeedSlider"
                                                    Minimum="50" Maximum="300" Value="140"
                                                    Style="{StaticResource ModernSlider}"
                                                    ValueChanged="SpeedSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Momentum -->
                                    <Border Padding="14,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="LblMomentum"
                                                           Text="Quán tính giữ đà"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="FrictionValue"
                                                           Text="Rất cao"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="FrictionSlider"
                                                    Minimum="80" Maximum="98" Value="97"
                                                    Style="{StaticResource ModernSlider}"
                                                    ValueChanged="FrictionSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Glide -->
                                    <Border Padding="14,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="LblGlide"
                                                           Text="Độ trôi cuối hành trình"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="GlideValue"
                                                           Text="Mạnh"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="GlideSlider"
                                                    Minimum="100" Maximum="500" Value="320"
                                                    Style="{StaticResource ModernSlider}"
                                                    ValueChanged="GlideSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource HairlineDivider}"/>

                                    <!-- Response Curve -->
                                    <Border Padding="14,10">
                                        <Grid>
                                            <TextBlock x:Name="LblAnimation"
                                                       Text="Đường cong nội suy"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="EasingComboBox"
                                                      Width="162"
                                                      HorizontalAlignment="Right"
                                                      Style="{StaticResource PrecisionComboBox}"
                                                      SelectionChanged="EasingComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Ease Out Quad" Tag="EaseOutQuad" IsSelected="True"/>
                                                <ComboBoxItem Content="Ease Out Cubic" Tag="EaseOutCubic"/>
                                                <ComboBoxItem Content="Ease Out Expo" Tag="EaseOutExpo"/>
                                                <ComboBoxItem Content="Ease Out Circ" Tag="EaseOutCirc"/>
                                                <ComboBoxItem Content="Ease In Out Quad" Tag="EaseInOutQuad"/>
                                                <ComboBoxItem Content="Linear" Tag="Linear"/>
                                                <ComboBoxItem Content="Ease Out Back" Tag="EaseOutBack"/>
                                                <ComboBoxItem Content="Elastic" Tag="EaseOutElastic"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section 03: Exclusions -->
                            <Border Style="{StaticResource SectionHeadingBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="5" Height="5"
                                                   Fill="{StaticResource TextInvertedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock x:Name="LblExceptions"
                                                   Text="BỘ LỌC TIẾN TRÌNH"
                                                   Style="{StaticResource SectionHeadingText}"/>
                                    </StackPanel>
                                    <TextBlock Text="[03]"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BorderSubtleBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SurfaceSection}" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="LblExcludedApps"
                                                   Text="Tiến trình ngoại lệ"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ExcludedAppsCount"
                                                   Text="Chưa loại trừ ứng dụng nào"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="BrowseAppsButton"
                                            Grid.Column="1"
                                            Content="THIẾT LẬP"
                                            Style="{StaticResource ActionButton}"
                                            VerticalAlignment="Center"
                                            Click="BrowseAppsButton_Click"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
