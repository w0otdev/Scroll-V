<Window x:Class="ScrollV.RunningAppsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scroll-V"
        Height="540" Width="420"
        WindowStyle="None"
        Background="#C8C2AE"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/appicon.ico">

    <Window.Resources>
        <Style x:Key="AppRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextInvertedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainContainer"
            Background="{StaticResource YorhaGridBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="2"
            CornerRadius="0"
            ClipToBounds="True">

        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                Margin="3">
            <DockPanel>
                <!-- YoRHa Dialog Header -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="14,10"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="7" Height="7"
                                       Fill="{StaticResource TextInvertedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleText"
                                       Text="DANH SÁCH TIẾN TRÌNH"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextInvertedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="RefreshButton"
                                    Content="QUÉT LẠI"
                                    Style="{StaticResource HeaderActionButton}"
                                    Margin="0,0,8,0"
                                    Click="RefreshButton_Click"/>
                            <Button x:Name="DialogCloseButton"
                                    Style="{StaticResource ChromeCloseButton}"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search Input & Hint -->
                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                    <Border x:Name="SearchInputBorder"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="2,1,1,1"
                            CornerRadius="0"
                            Padding="10,8">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="{StaticResource AppFont}"
                                     FontSize="12.5"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Lọc theo tên tiến trình hoặc cửa sổ..."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="HintText"
                               Text="Chuyển sang TẮT để giữ nguyên cuộn mặc định của Windows trên ứng dụng đó."
                               FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="2,7,2,0"/>
                </StackPanel>

                <!-- Process List -->
                <Border Style="{StaticResource SurfaceSection}"
                        Margin="14,0,14,14"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ThinScrollViewer}">
                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppRowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="4" Height="4"
                                                               Fill="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WindowTitle}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="10,2,0,0"/>
                                            </StackPanel>

                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource PrecisionToggle}"
                                                      Click="AppToggle_Click"
                                                      Tag="{Binding ProcessName}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Border>
</Window>
